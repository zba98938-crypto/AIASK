.bce-tool/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Node (kept so a stray install cannot be committed; this tree is backend-only)
node_modules/

# Local runtime state: SQLite databases and their WAL/SHM sidecars
*.sqlite
*.sqlite3
*.db
*-wal
*-shm

# Logs and temporary output
logs/
*.log
tmp/
.DS_Store

# Local environment files. env.example is the tracked template.
.env
.env.*
!.env.example

# Sandboxed-runner state. .aiask-local holds a multi-GB snapshot of the runtime
# DB; scripts_local_bootstrap redirects runners to it via a machine-specific
# path. Neither is authoritative (see docs/DATA_SOURCES.md §10).
.aiask-local/
scripts_local_bootstrap/
.learnings/

# Generated continuous-quality runtime reports, evidence snapshots and archives.
docs/strategy-factory-quality/continuous-*/evidence/
docs/strategy-factory-quality/continuous-*/runs/
docs/strategy-factory-quality/continuous-*/*.json
docs/strategy-factory-quality/continuous-*/*.jsonl
