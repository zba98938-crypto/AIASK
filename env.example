# AIASK backend integration environment template.
# Copy to your shell/profile or a local .env outside git tracking if needed.
# This file intentionally contains variable names and safe placeholders only.

# SQLite database location. Prefer an absolute path outside the Hermes git tree.
AIASK_SQLITE_PATH=
AKSHARE_MCP_SQLITE_PATH=
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_JOURNAL_MODE=WAL

# Data source behavior.
TDX_LOCAL_ONLY=
TQ_CENTER_PATH=
TUSHARE_TOKEN=
AKSHARE_MCP_STARTUP_PROFILE=full
AKSHARE_MCP_BACKGROUND_SERVICES_LOCK_PATH=

# Optional external finance software / broker paths.
TDX_SERVER_IP=119.147.212.81
TDX_SERVER_PORT=7709
THS_BROKER=
QMT_ACCOUNT_TYPE=STOCK
QMT_PATH=

# AI/model provider keys used by optional workflows.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
AIASK_LLM_PROVIDER=
AIASK_LLM_MODEL=

# Agent/API guardrails.
AIASK_AGENT_TOKEN=
AIASK_AGENT_CONTROL_TOKEN=
AIASK_AGENT_HOST=127.0.0.1
AIASK_AGENT_PORT=8000

# Optional runtime flags.
AIASK_PROJECT_ROOT=
INCUBATION_FACTORY_RECOMPILE_REMEDIATION_ENABLED=
INCUBATION_FACTORY_RECOMPILE_REMEDIATION_BATCH_LIMIT=
