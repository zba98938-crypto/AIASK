# AIASK backend integration environment template.
# Copy to your shell/profile or a local .env outside git tracking if needed.
# This file intentionally contains variable names and safe placeholders only.

# SQLite database location. Prefer an absolute path outside the Hermes git tree.
AIASK_SQLITE_PATH=
AKSHARE_MCP_SQLITE_PATH=
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_JOURNAL_MODE=WAL

# Python environment.
# AIASK's packages live in a conda env. scripts/run_mcp_stdio.py and
# scripts/aiask_readiness.py resolve the interpreter in this order:
#   1. AIASK_VENV_PYTHON, when set (an explicit override always wins)
#   2. <AIASK_RUNTIME_HOME>/venv/bin/python, when an isolated venv exists
#   3. the conda env named here
# If none resolve, launchers fail closed rather than run under an arbitrary
# Python. Set AIASK_VENV_PYTHON to a conda env python to skip discovery.
AIASK_CONDA_ENV=aiask
AIASK_VENV_PYTHON=
# Longest a task run may stay `running` before a later cycle reclaims it as
# `timed_out`. Nothing is inferred about the run's outcome; the state just stops
# claiming the run is alive.
STRATEGY_TASK_RUN_STALE_SECONDS=21600

# Data source behavior.
TDX_LOCAL_ONLY=
TQ_CENTER_PATH=
# Only used when DATA_SOURCE_KEEP_LEGACY_FALLBACK=1 (off by default). Without a
# token every tushare call fails; the default path (TDX) does not need one.
TUSHARE_TOKEN=
AKSHARE_MCP_STARTUP_PROFILE=full
AKSHARE_MCP_BACKGROUND_SERVICES_LOCK_PATH=

# Optional external finance software / broker paths.
TDX_SERVER_IP=119.147.212.81
TDX_SERVER_PORT=7709
THS_BROKER=
QMT_ACCOUNT_TYPE=STOCK
QMT_PATH=

# AI/model provider keys used by optional workflows.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Model selection. These are the names env_config.py actually reads; the older
# AIASK_LLM_PROVIDER / AIASK_LLM_MODEL spellings had no reader and did nothing.
AIASK_AGENT_MODEL_PROVIDER=
AIASK_AGENT_MODEL=

# Agent/API guardrails.
# Bearer token required when the agent binds a non-loopback host. Loopback
# clients are allowed without it. Note the AGENT_API prefix: AIASK_AGENT_TOKEN
# is not read anywhere.
AIASK_AGENT_API_TOKEN=
# Loopback-only token gating control and mutating endpoints.
AIASK_AGENT_CONTROL_TOKEN=
AIASK_AGENT_HOST=127.0.0.1
# Default agent HTTP port. Keep in sync with the Makefile smoke target and the
# monitoring probes.
AIASK_AGENT_PORT=8765

# Optional runtime flags.
# Absolute path to this tree. Set it when the automatic root discovery cannot
# resolve the layout (for example when the packages are installed elsewhere).
AIASK_PROJECT_ROOT=
# Runtime state directory. Defaults to ~/.aiask.
AIASK_RUNTIME_HOME=
INCUBATION_FACTORY_RECOMPILE_REMEDIATION_ENABLED=
INCUBATION_FACTORY_RECOMPILE_REMEDIATION_BATCH_LIMIT=

# Declared holding-period exit policy (chosen 2026-10-20).
# Close paper positions that exceed the strategy's declared max_holding_days.
# This is not a default for every strategy: strategies without a declared
# horizon remain on the signal-driven exit path.
INCUBATION_FACTORY_STALE_PAPER_POSITION_CLOSURE_ENABLED=1
INCUBATION_FACTORY_STALE_PAPER_POSITION_CLOSURE_BATCH_LIMIT=100
INCUBATION_FACTORY_STALE_PAPER_POSITION_CLOSURE_GRACE_DAYS=0

# Strategy-factory LLM provider (OpenAI-compatible). Keys stay in the local,
# gitignored .env — never put a real key here.
# LLM_BASE_URL for this gateway is https://ai.anna.tf/v1 (model Claude-Opus-4.6)
STRATEGY_LLM_ENABLED=0
STRATEGY_LLM_PROVIDER=openai_compatible
STRATEGY_LLM_BASE_URL=
STRATEGY_LLM_API_KEY=
STRATEGY_LLM_MODEL=
